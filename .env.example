# Copy this file to .env (which git ignores) and fill in what you want. Never commit real keys.

# A better voice for Jarvis. Get a key at https://elevenlabs.io (the free tier works), then paste it here.
# With a key set, replies are spoken by ElevenLabs instead of the Mac voice, and the text of each reply
# is sent to ElevenLabs. Without one (or if it fails), Jarvis uses the Mac voice.
ELEVENLABS_API_KEY=

# Optional: a different ElevenLabs voice (George, a British male voice, is the default).
# JARVIS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
